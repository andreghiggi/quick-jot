# URLs postgres para espelhamento auth (local) — NÃO commitar .env.backup
#
# Onde obter:
# - Lovable/origem: Supabase Dashboard → iwmrtxdzlkasuzutxvhh → Settings → Database → Connection string (URI)
# - Externo/destino: Supabase Dashboard → vyotbtmnnosiejyltlxc → Settings → Database → Connection string (URI)
#
# Use a senha do banco (não a anon key). Modo Transaction ou Session pooler.

SOURCE_DB_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
TARGET_DB_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
